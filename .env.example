# HomePlus Environment Variables
# Copy this file to .env and update the values

# ============================================
# DEMO MODE TOGGLE
# ============================================
# Set to "true" for demo/presentation mode with dummy data
# Set to "false" for production mode
VITE_DEMO_MODE="true"

# ============================================
# DEMO CREDENTIALS (when VITE_DEMO_MODE="true")
# ============================================
# Email: demo@homeplus.com
# Password: demo123
#
# Note: In demo mode, any email/password combination will work.
# The above credentials are just for demonstration purposes.

# ============================================
# SOCIAL SIGN-IN
# ============================================
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Apple Developer -> Certificates, Identifiers & Profiles -> Identifiers -> Services ID
VITE_APPLE_CLIENT_ID=
# Must be a redirect URI registered on that Services ID (popup flow still requires one)
VITE_APPLE_REDIRECT_URI=
